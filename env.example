# Neon PostgreSQL — copy to .env and fill in. Never commit .env.
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler") — used by Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Gnani (Prisma v2.5 STT + Timbre v2.5 TTS) — server-side only, never NEXT_PUBLIC_
GNANI_API_KEY=""
# Groq — used only for structured complaint extraction. Server-side only.
# Key from https://console.groq.com
GROQ_API_KEY=""
# Optional: override the default model (must support strict structured outputs)
# GROQ_MODEL="openai/gpt-oss-120b"

# Map tiles (optional). Default is OpenStreetMap's public server, which blocks heavy/dev/tunnel traffic.
# For a reliable demo, paste a raster XYZ URL from a tile provider (e.g. one with a free key). Keep the OSM credit in the attribution.
# NEXT_PUBLIC_TILE_URL="https://YOUR-PROVIDER/{z}/{x}/{y}.png?key=YOUR_MAP_KEY"
# NEXT_PUBLIC_TILE_ATTRIBUTION='&copy; Provider &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Protects /api/health/services (deployment check). Use a long random string. Unset = endpoint disabled.
HEALTH_TOKEN=""
